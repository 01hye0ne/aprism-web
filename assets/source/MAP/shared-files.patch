+  transform: translate(-50%, -50%);
+  border: calc(3px * var(--bot-zoom, 1)) solid var(--bg-canvas);
+  border-radius: 50%;
+  background-color: var(--bot-tint, var(--color-main-600));
+  box-shadow: 0 0 0 calc(1px * var(--bot-zoom, 1)) var(--bot-tint, var(--color-main-600)),
